# ==========================================
# ShopSphere .gitignore - Complete Security Rules
# ==========================================

# 1. Environment and Secrets (CRITICAL)
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env
!.env.example
!backend/.env.example

# 2. Aiven Kafka Certificates and Keys (CRITICAL)
certs/*.pem
certs/*.cert
certs/*.key
certs/*.crt
certs/*.p12
backend/certs/*.pem
backend/certs/*.cert
backend/certs/*.key
backend/certs/*.crt
backend/certs/*.p12
*.pem
*.cert
*.key
*.crt
*.p12
*.pfx
*.jks
!backend/certs/README.txt

# 3. Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# 4. Production Build Outputs & Vite Caches
dist/
build/
frontend/dist/
.vite/
frontend/.vite/
.cache/
.eslintcache

# 5. Logs and Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 6. Operating System Files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# 7. IDE and Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*~

