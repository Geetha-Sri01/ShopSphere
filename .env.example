# ==============================================================================
# SHOPSPHERE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Create a copy of this file named ".env" inside the "backend" directory:
#    cp .env.example backend/.env
# 2. Replace the placeholder values with your real credentials from the Aiven Console.
# 3. Never commit your actual .env file or certificates to GitHub (protected by .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
ADMIN_API_KEY=shopsphere_admin_secret_2026

# ------------------------------------------------------------------------------
# 1. AIVEN POSTGRESQL CONFIGURATION
# ------------------------------------------------------------------------------
# WHERE TO FIND IN AIVEN CONSOLE:
# 1. Log in to https://console.aiven.io/
# 2. Select or create your "PostgreSQL" service.
# 3. In the "Overview" tab under "Connection information", copy the "Service URI".
# 4. Replace YOUR_PASSWORD with your actual database password.
#
# Once set, run database setup in the terminal:
#   cd backend
#   npm run seed
DATABASE_URL=postgres://avnadmin:YOUR_PASSWORD@your-pg-service.aivencloud.com:18826/defaultdb?sslmode=require

# ------------------------------------------------------------------------------
# 2. AIVEN APACHE KAFKA CONFIGURATION
# ------------------------------------------------------------------------------
# WHERE TO FIND IN AIVEN CONSOLE:
# 1. Select or create your "Apache Kafka" service.
# 2. In the "Overview" tab under "Connection information":
#    - Copy the host and port only from "Service URI" (do not include kafka:// or credentials).
#    - Download the 3 SSL certificate files to "backend/certs/":
#        a) CA Certificate      -> save as backend/certs/ca.pem
#        b) Access Certificate  -> save as backend/certs/service.cert
#        c) Access Key          -> save as backend/certs/service.key
# 3. In the "Topics" tab, click "Create topic", name it "shopsphere-orders".
KAFKA_BROKERS=your-kafka-service.aivencloud.com:18828
KAFKA_CLIENT_ID=shopsphere-backend
KAFKA_GROUP_ID=shopsphere-order-consumer
KAFKA_TOPIC=shopsphere-orders
KAFKA_SSL=true

# Paths to the downloaded SSL certificate files (relative to backend directory):
KAFKA_CA_CERT_PATH=./certs/ca.pem
KAFKA_ACCESS_CERT_PATH=./certs/service.cert
KAFKA_ACCESS_KEY_PATH=./certs/service.key

# Alternative: If using SASL/SCRAM instead of mutual SSL certificates:
# KAFKA_SASL_USERNAME=avnadmin
# KAFKA_SASL_PASSWORD=YOUR_PASSWORD
# KAFKA_SASL_MECHANISM=scram-sha-512

# ------------------------------------------------------------------------------
# 3. AIVEN OPENSEARCH CONFIGURATION
# ------------------------------------------------------------------------------
# WHERE TO FIND IN AIVEN CONSOLE:
# 1. Select or create your "OpenSearch" service.
# 2. In the "Overview" tab under "Connection information", copy the full "Service URI".
# 3. Replace YOUR_PASSWORD with your actual OpenSearch password.
#
# Once set, create the index and upload sample products:
#   cd backend
#   npm run sync-search
OPENSEARCH_NODE=https://avnadmin:YOUR_PASSWORD@your-opensearch-service.aivencloud.com:18830
OPENSEARCH_INDEX=products
OPENSEARCH_SSL_REJECT_UNAUTHORIZED=false
